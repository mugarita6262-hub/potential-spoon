# 楽天ウェブサービスのアプリ詳細ページの値（2026年2月以降の新方式）

# アプリケーションID（UUID形式。例: d0b8f0ec-6cda-4451-8d3d-303c6493e5fe）
RAKUTEN_APP_ID=

# アクセスキー（目のアイコンで表示できる長い文字列。秘密情報）
RAKUTEN_ACCESS_KEY=

# アフィリエイトID（任意。例: 0acd7539.17512f5b.0acd753a.396248af）
RAKUTEN_AFFILIATE_ID=

# Claude API キー（任意。設定すると prepare がキャプションを自動生成する）
# https://console.anthropic.com/ → API Keys で発行
ANTHROPIC_API_KEY=
