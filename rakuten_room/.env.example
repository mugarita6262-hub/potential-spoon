# 楽天ウェブサービスのアプリ詳細ページの値（2026年2月以降の新方式）

# アプリケーションID（UUID形式。例: d0b8f0ec-6cda-4451-8d3d-303c6493e5fe）
RAKUTEN_APP_ID=

# アクセスキー（目のアイコンで表示できる長い文字列。秘密情報）
RAKUTEN_ACCESS_KEY=

# アフィリエイトID（任意。例: 0acd7539.17512f5b.0acd753a.396248af）
RAKUTEN_AFFILIATE_ID=

# Claude API キー（任意。設定すると prepare がキャプションを自動生成する）
# https://console.anthropic.com/ → API Keys で発行
ANTHROPIC_API_KEY=

# --- SNS拡散（Threads）用（任意。設定すると `sns`/`daily` コマンドが動きます） ---
# 取得手順は SETUP_THREADS.md を参照
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- サーバー常駐用Webダッシュボード（src/webapp.py）用（サーバー運用時のみ必要） ---
# ブラウザからのBasic認証。第三者に触られないよう必ず強い値を設定すること
WEBAPP_USER=admin
WEBAPP_PASSWORD=
WEBAPP_PORT=8080

# --- プッシュ通知（ntfy.sh、任意）---
# アカウント登録不要。好きなトピック名を決めて、ntfyアプリ/ブラウザで購読しておく
# https://ntfy.sh/<トピック名> をブラウザで開くだけでも動作確認できます
NTFY_TOPIC=

# --- サーバー同期用（任意、サーバー運用している場合のみ）---
# おまかせ実行時に自動でサーバーとの差分（自動昇格ジャンル・A8依頼）を確認する
GCLOUD_INSTANCE=
GCLOUD_ZONE=
